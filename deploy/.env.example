# needle-server 配置。复制为 .env 并填写:
#
#   cp .env.example .env && ${EDITOR:-vi} .env

# 看板对外域名。caddy 会为它签证书并反代到本服务。
# 本机 caddy 只接 *.dev.typist.cc, 腾讯云 caddy 接 *.typist.cc。
NEEDLE_DOMAIN=needle.dev.typist.cc

# 镜像标签。latest 跟随 main 分支每次构建; 也可填版本号 (1.0.0) 或
# sha-<commit> 固定到某次构建。
NEEDLE_TAG=latest

# agent 上报凭证。agent 侧用同一个值 (--token / NEEDLE_TOKEN)。
#   openssl rand -hex 32
NEEDLE_AGENT_TOKEN=

# 看板登录密码。留空则看板不做鉴权 (仅适合内网)。
NEEDLE_PASSWORD=

# 会话 cookie 的签名密钥。留空则由 agent token + 密码派生,
# 改密码即会让已登录的会话全部失效。显式设置可让两者独立轮换。
#   openssl rand -hex 32
NEEDLE_SESSION_SECRET=
